{
  "name": "aria-v3-monorepo",
  "version": "3.1.0",
  "private": true,
  "description": "ARIA — Cognitive Operating System v3.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node agent.js",
    "api": "node apps/api/src/index.js",
    "workers": "node apps/workers/src/index.js",
    "ocr:server": "python services/ocr/paddle_server.py",
    "dev": "nodemon agent.js",
    "dev:api": "nodemon apps/api/src/index.js",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:migrate": "node infrastructure/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@hapi/boom": "^10.0.0",
    "@qdrant/js-client-rest": "^1.8.2",
    "@whiskeysockets/baileys": "^6.7.0",
    "axios": "^1.6.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^4.26.0",
    "form-data": "^4.0.5",
    "langsmith": "^0.1.0",
    "mammoth": "^1.7.0",
    "natural": "^6.12.0",
    "neo4j-driver": "^5.28.3",
    "openai": "^4.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "qrcode-terminal": "^0.12.0",
    "redis": "^5.0.0",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.0.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
