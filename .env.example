# ── LLM Principal ─────────────────────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-30b-a3b
LM_STUDIO_TIMEOUT_MS=30000
LM_STUDIO_MAX_TOKENS=4096
LM_STUDIO_TEMPERATURE=0.7

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=jina          # jina | openai | lmstudio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
JINA_API_KEY=
OPENAI_API_KEY=

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_PROVIDER=jina           # jina | bge | llm | heuristic
RERANKER_MODEL=jina-reranker-v2-base-en
HF_API_KEY=

# ── Fallback LLM (opcional) ───────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-r1-0528

# ── Bases de datos ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://aria:ariapass@localhost:5432/aria_db
POSTGRES_PASSWORD=ariapass

# ── Qdrant (Vector DB — OBLIGATORIO) ──────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aria_vectors
EMBEDDING_DIM=1024                # Auto-detectado, configurable override

# ── Neo4j (Knowledge Graph — opcional) ────────────────────────────────────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── OCR y Parsing de Documentos ───────────────────────────────────────────────
PADDLE_OCR_URL=http://localhost:8001
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_STRATEGY=hi_res     # auto | fast | hi_res | ocr_only

# ── API Gateway ───────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=*

# ── Sesiones ──────────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=30

# ── Observabilidad ────────────────────────────────────────────────────────────
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=aria-v3
LOG_LEVEL=info
NODE_ENV=development

# ── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_SESSION_DIR=./data/sessions

# ── Workers BullMQ ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
RESEARCH_WORKER_CONCURRENCY=3
DOCUMENT_WORKER_CONCURRENCY=5

# ── Seguridad ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=30
